steps:
- id: touch
  in:
    filename: !ii greeting.txt
  out:
  - file: !& empty_file
- id: append
  in:
    file: !* empty_file
    str: !ii Hello, Sophios
  out:
  - file: !& greeting_file
- id: shout
  run: shout.cwl
  in:
    text: !* greeting_file
  out:
  - shouted: !& shouted_file
- id: word_count
  run: word_count.cwl
  in:
    text: !* greeting_file
  out:
  - counts: !& counts_file
- id: combine
  run: combine.cwl
  in:
    text: !* shouted_file
    counts: !* counts_file
